# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Postgres en GCP (Cloud SQL): herramientas + memoria del agente ---
PG_HOST=
PG_PORT=5432
PG_DB=
PG_USER=
PG_PASSWORD=
PG_SSLMODE=require

# --- Elasticsearch (VM en GCP): base de conocimiento del RAG ---
ES_URL=http://IP_O_HOST:9200
ES_USER=elastic
ES_PASSWORD=

# --- RAG: "langchain" (por defecto) o "llamaindex" ---
RAG_BACKEND=langchain

# --- LangSmith (opcional: trazas del agente) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-cobranzas-final

# --- Otros (opcionales) ---
APP_TZ=America/Lima
# CORS_ORIGINS=https://mi-frontend.vercel.app
